{
  "name": "room-reservation-worker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-local-dev.mjs",
    "build": "node scripts/run-wrangler-build.mjs",
    "check": "tsc --noEmit && node scripts/check-architecture.mjs && node scripts/check-rate-limit-config.mjs && node scripts/check-cloudflare-deploy-config.mjs && node scripts/check-cloudflare-cicd.mjs",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.migration.config.ts",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "test:isolated-postgres": "node scripts/run-isolated-postgres.mjs",
    "test:local-e2e": "node scripts/run-local-e2e.mjs",
    "test:uat-e2e": "node scripts/run-uat-e2e.mjs",
    "test:uat-rate-limit": "node scripts/validate-rate-limit-uat.mjs",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:production:preflight": "tsx scripts/production-migration.ts preflight",
    "migrate:production:apply": "tsx scripts/production-migration.ts apply",
    "migrate:production:verify": "tsx scripts/production-migration.ts verify",
    "uat:create-database": "tsx scripts/create-disposable-uat-database.ts",
    "uat:prepare": "tsx scripts/prepare-uat.ts",
    "uat:check-residual": "tsx scripts/check-disposable-uat-residual.ts",
    "deploy:uat": "node scripts/run-wrangler-deploy.mjs uat",
    "deploy:production": "node scripts/run-wrangler-deploy.mjs production",
    "deploy:validate": "node scripts/validate-cloudflare-production-config.mjs",
    "deploy:verify-targets": "node scripts/verify-cloudflare-production-targets.mjs",
    "deploy:pages:production": "node scripts/deploy-cloudflare-pages.mjs",
    "deploy:smoke:production": "node scripts/smoke-cloudflare-production.mjs",
    "artifact:manifest": "node scripts/artifact-manifest.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "hono": "4.12.31"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.6",
    "@cloudflare/workers-types": "5.20260719.1",
    "@types/node": "24.0.15",
    "@types/pg": "8.20.0",
    "node-pg-migrate": "9.0.0",
    "pg": "8.22.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  },
  "overrides": {
    "sharp": "0.35.3"
  }
}
