{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "room-reservation-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "uat": {
      "name": "<uat-worker-name>",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "uat",
        "E2E_CLEANUP_ENABLED": "true"
      },
      "ratelimits": [
        {
          "name": "INGRESS_GUARD_RATE_LIMITER",
          "namespace_id": "<uat-ingress-namespace-id>",
          "simple": { "limit": 600, "period": 60 }
        },
        {
          "name": "PUBLIC_READ_RATE_LIMITER",
          "namespace_id": "<uat-read-namespace-id>",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "PUBLIC_WRITE_RATE_LIMITER",
          "namespace_id": "<uat-write-namespace-id>",
          "simple": { "limit": 24, "period": 60 }
        }
      ]
    },
    "production": {
      "name": "<production-worker-name>",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "prod",
        "E2E_CLEANUP_ENABLED": "false"
      },
      "ratelimits": [
        {
          "name": "INGRESS_GUARD_RATE_LIMITER",
          "namespace_id": "<production-ingress-namespace-id>",
          "simple": { "limit": 600, "period": 60 }
        },
        {
          "name": "PUBLIC_READ_RATE_LIMITER",
          "namespace_id": "<production-read-namespace-id>",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "PUBLIC_WRITE_RATE_LIMITER",
          "namespace_id": "<production-write-namespace-id>",
          "simple": { "limit": 24, "period": 60 }
        }
      ]
    }
  }
}
